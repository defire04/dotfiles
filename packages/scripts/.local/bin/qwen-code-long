#!/bin/bash
# qwen-code на старой Qwen3.8-27B с окном 100K без MTP: умнее MoE, но медленнее
# (~31 т/с на пустом окне, ~19 т/с при заполненных 90K; замеры 03.11.2026).
# Обычный qwen-code теперь на Qwen3.6-35B-A3B с окном 256K.
QWEN_MODEL=27b QWEN_CTX=102400 QWEN_MTP=0 exec "$HOME/.local/bin/qwen-code" "$@"
