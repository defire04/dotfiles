#!/usr/bin/env bash
# cam-on: undo cam-off, remove the block and load the webcam driver back.
set -u
CONF=/etc/modprobe.d/cam-off.conf

sudo rm -f "$CONF" || exit 1
sudo modprobe uvcvideo || exit 1
for _ in 1 2 3 4 5; do
    ls /dev/video* >/dev/null 2>&1 && break
    sleep 1
done
if ls /dev/video* >/dev/null 2>&1; then
    echo "📷 Камера включена. Выключить: cam-off"
else
    echo "Драйвер загружен, но камера не появилась, проверь: lsusb | grep -i cam"
    exit 1
fi
