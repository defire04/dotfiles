#!/bin/bash
# Обёртка над Pi (~/.local/share/npm/bin/pi или /usr/bin/pi из AUR): локальная Qwen и песочница srt.
#   pi [аргументы]     Pi в текущей папке; llama-server поднимается сам, если не запущен
#   pi server-stop     остановить сервер и освободить видеопамять
#   pi server-status   запущен ли сервер
# Служебные команды Pi (install, list, update, config…) идут напрямую, без сервера и песочницы.
# Сервер под машину: ~/.local/share/llm/start-pi-server.sh. Песочница: ~/.config/pi/srt.json
# (писать можно только в текущую папку и кэши сборки, сеть только до 127.0.0.1:8080).
set -u
REAL=${PI_REAL:-}
for c in "$HOME/.local/share/npm/bin/pi" /usr/bin/pi; do [ -z "$REAL" ] && [ -x "$c" ] && REAL=$c; done
[ -n "$REAL" ] || { echo "настоящий pi не найден (npm или AUR pi-coding-agent-bin)"; exit 1; }
LLM=$HOME/.local/share/llm
LOG=$LLM/pi-server.log
health() { curl -sf 127.0.0.1:8080/health >/dev/null; }

case "${1:-}" in
  server-stop)   pkill -f '^(/usr/bin/|[^ ]*/)?llama-server .*--port 8080' && echo "сервер остановлен" || echo "сервер не запущен"; exit 0 ;;
  server-status) health && echo "сервер работает" || echo "сервер не запущен"; exit 0 ;;
  install|remove|uninstall|update|list|config|auth|mcp|--help|-h|--version|-v|--list-models) exec "$REAL" "$@" ;;
esac

if ! health; then
  echo "запускаю llama-server, лог $LOG"
  setsid "$LLM/start-pi-server.sh" > "$LOG" 2>&1 < /dev/null &
  for i in $(seq 180); do health && break; sleep 1; done
  health || { echo "сервер не поднялся, см. $LOG"; exit 1; }
fi

# Внутри srt 127.0.0.1 это сеть самой песочницы, поэтому до сервера идём через её прокси (NO_PROXY без 127.0.0.1).
export PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0 CARGO_NET_OFFLINE=true
# Буфер: в песочнице нет доступа к Wayland. Снаружи wl-paste --watch сохраняет только картинки в ~/.cache/pi-clip,
# внутри Pi видит подменный wl-paste (~/.config/pi/clip), который отдаёт их по Ctrl+V. Текст вставлять Ctrl+Shift+V.
# Копирование: подменный wl-copy молчит, а Pi кладёт текст в буфер через терминал (OSC 52, kitty это разрешает).
CLIP=$HOME/.config/pi/clip
WP=""
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null; then
  mkdir -p -m 700 "$HOME/.cache/pi-clip"
  "$CLIP/save" < /dev/null
  wl-paste --watch "$CLIP/save" >/dev/null 2>&1 &
  WP=$!
fi
ARGS=$(printf ' %q' "$@")
srt -s "$HOME/.config/pi/srt.json" -c \
  "export PATH=$CLIP:\$PATH PI_CLIPBOARD_OSC52=1 NO_PROXY=169.254.0.0/16 no_proxy=169.254.0.0/16 NODE_USE_ENV_PROXY=1; exec $REAL$ARGS"
rc=$?
[ -n "$WP" ] && kill $WP 2>/dev/null
exit $rc
