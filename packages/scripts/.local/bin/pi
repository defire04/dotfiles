#!/bin/bash
# Обёртка над Pi (~/.local/share/npm/bin/pi): локальная Qwen и песочница srt.
#   pi [аргументы]     Pi в текущей папке; llama-server поднимается сам, если не запущен
#   pi server-stop     остановить сервер и освободить видеопамять
#   pi server-status   запущен ли сервер
# Служебные команды Pi (install, list, update, config…) идут напрямую, без сервера и песочницы.
# Сервер под машину: ~/.local/share/llm/start-pi-server.sh. Песочница: ~/.config/pi/srt.json
# (писать можно только в текущую папку и кэши сборки, сеть только до 127.0.0.1:8080).
set -u
REAL=$HOME/.local/share/npm/bin/pi
LLM=$HOME/.local/share/llm
LOG=$LLM/pi-server.log
health() { curl -sf 127.0.0.1:8080/health >/dev/null; }

case "${1:-}" in
  server-stop)   pkill -f 'llama-server.*--port 8080' && echo "сервер остановлен" || echo "сервер не запущен"; exit 0 ;;
  server-status) health && echo "сервер работает" || echo "сервер не запущен"; exit 0 ;;
  install|remove|uninstall|update|list|config|auth|mcp|--help|-h|--version|-v|--list-models) exec "$REAL" "$@" ;;
esac

if ! health; then
  echo "запускаю llama-server, лог $LOG"
  setsid "$LLM/start-pi-server.sh" > "$LOG" 2>&1 < /dev/null &
  for i in $(seq 180); do health && break; sleep 1; done
  health || { echo "сервер не поднялся, см. $LOG"; exit 1; }
fi

# Внутри srt 127.0.0.1 это сеть самой песочницы, поэтому до сервера идём через её прокси (NO_PROXY без 127.0.0.1).
export PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0 CARGO_NET_OFFLINE=true
ARGS=$(printf ' %q' "$@")
exec srt -s "$HOME/.config/pi/srt.json" -c \
  "export NO_PROXY=169.254.0.0/16 no_proxy=169.254.0.0/16 NODE_USE_ENV_PROXY=1; exec $REAL$ARGS"
