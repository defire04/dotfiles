#!/usr/bin/env python3
# menu-keywords — русские и английские слова для поиска в меню KDE: пишешь «scan», «монитор»,
#   «word», находит нужную программу. Названия в меню не меняются.
#   menu-keywords   дописать слова в копии ярлыков ~/.local/share/applications (повторный запуск безопасен)
# Ярлык программы, которой нет на этой машине, пропускается.
import os, re, subprocess

KEYWORDS = {
    'libreoffice-writer': 'документ;текст;word;ворд;doc;docx',
    'libreoffice-calc': 'таблицы;excel;эксель;xls;xlsx',
    'libreoffice-impress': 'презентация;слайды;powerpoint;ppt',
    'libreoffice-draw': 'схема;рисунок;pdf',
    'libreoffice-base': 'база;access',
    'libreoffice-math': 'формулы',
    'libreoffice-startcenter': 'офис;office',
    'org.kde.skanpage': 'сканер;скан;сканировать;pdf;scanner;scan',
    'org.kde.okular': 'pdf;читать;книга;djvu;epub;reader',
    'org.kde.plasma-systemmonitor': 'монитор;мониторинг;процессы;диспетчер задач;нагрузка;monitoring;task manager;процессор;cpu',
    'btop': 'монитор;мониторинг;процессы;нагрузка;monitoring;top;htop',
    'org.kde.dolphin': 'файлы;проводник;папки;explorer;files',
    'brave-browser': 'браузер;интернет;browser;chrome;хром',
    'firefox': 'браузер;интернет;browser',
    'org.kde.kate': 'редактор;блокнот;текст;notepad;editor',
    'org.kde.kwrite': 'блокнот;текст;notepad',
    'org.kde.konsole': 'терминал;консоль;terminal;cmd',
    'kitty': 'терминал;консоль;terminal;cmd',
    'org.kde.spectacle': 'скриншот;снимок экрана;screenshot;запись экрана;snip',
    'org.kde.gwenview': 'фото;картинки;изображения;photos;images;viewer',
    'org.kde.haruna': 'видео;плеер;фильм;video;player',
    'mpv': 'видео;плеер;фильм;video;player',
    'org.kde.ark': 'архив;zip;rar;7z;распаковать;unzip',
    'org.kde.kcalc': 'калькулятор;calculator',
    'systemsettings': 'настройки;параметры;панель управления;settings;control panel',
    'org.kde.filelight': 'место на диске;что занимает место;disk usage;размер папок',
    'org.kde.partitionmanager': 'диски;разделы;разметка;partitions;disk',
    'kdiskmark': 'скорость диска;тест диска;benchmark;disk speed',
    'org.kde.kinfocenter': 'о системе;железо;информация;system info;hardware',
    'btrfs-assistant': 'снимки;откат;бэкап;snapshots;snapper;rollback;backup',
    'org.remmina.Remmina': 'удалённый рабочий стол;rdp;vnc;anydesk;remote desktop',
    'org.telegram.desktop': 'телеграм;мессенджер;telegram;tg',
    'steam': 'игры;стим;games',
    'com.obsproject.Studio': 'запись экрана;стрим;obs;record;screen recording',
    'org.kde.kwalletmanager': 'пароли;бумажник;passwords;wallet',
    'org.kde.kdeconnect.app': 'телефон;phone;android',
}

LOCAL = os.path.expanduser('~/.local/share/applications')
os.makedirs(LOCAL, exist_ok=True)

for app, words in KEYWORDS.items():
    dst = f'{LOCAL}/{app}.desktop'
    src = dst if os.path.exists(dst) else f'/usr/share/applications/{app}.desktop'
    if not os.path.exists(src):
        continue
    lines = open(src).read().split('\n')
    new = [w for w in words.split(';') if w]
    out, sec, done = [], None, False
    for line in lines:
        if line.startswith('['):
            sec = line
        if sec == '[Desktop Entry]' and line.startswith('Keywords[ru]='):
            have = [w for w in line.split('=', 1)[1].split(';') if w]
            line = 'Keywords[ru]=' + ';'.join(have + [w for w in new if w not in have]) + ';'
            done = True
        out.append(line)
    if not done:
        # без своей строки [ru] KDE брал общие Keywords=, их тоже переносим, иначе пропадут
        base = next((l.split('=', 1)[1] for l in out if l.startswith('Keywords=')), '')
        have = [w for w in base.split(';') if w]
        out.insert(out.index('[Desktop Entry]') + 1,
                   'Keywords[ru]=' + ';'.join(have + [w for w in new if w not in have]) + ';')
    # Skanpage вдобавок в раздел «Офис»
    if app == 'org.kde.skanpage':
        out = [re.sub(r'^Categories=.*', 'Categories=Qt;KDE;Office;Scanning;', l) for l in out]
    open(dst, 'w').write('\n'.join(out))
    print(app)

subprocess.run(['kbuildsycoca6'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
