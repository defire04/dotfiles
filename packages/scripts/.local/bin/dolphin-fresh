#!/bin/sh
# Обёртка Dolphin: перед запуском снять ЗАВИСШИЕ kdeconnect sshfs-маунты
# (остаются на мёртвом IP телефона после смены адреса и вешают Dolphin).
# Живые (отвечающие) маунты НЕ трогаем — только мёртвые.

for m in $(mount 2>/dev/null | awk '/kdeconnect@.*fuse\.sshfs/ {print $3}'); do
    if ! timeout 2 stat "$m" >/dev/null 2>&1; then
        fusermount3 -uz "$m" 2>/dev/null
    fi
done

exec /usr/bin/dolphin "$@"
