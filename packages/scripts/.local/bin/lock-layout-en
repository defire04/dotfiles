#!/bin/bash
# Экран блокировки всегда на английской раскладке: при блокировке переключает на первую в списке (us).
# Служба lock-layout-en.service (systemd --user).
dbus-monitor --session "type='signal',interface='org.freedesktop.ScreenSaver',member='ActiveChanged'" |
while read -r line; do
    [[ $line == *"boolean true"* ]] && qdbus6 org.kde.keyboard /Layouts org.kde.KeyboardLayouts.setLayout 0 >/dev/null
done
