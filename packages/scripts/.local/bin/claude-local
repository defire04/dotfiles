#!/bin/bash
# Claude Code на локальном Qwen3.8 27B (llama-server на 127.0.0.1:8080).
# Свои чаты и настройки в ~/.claude-local, обычный claude и ~/.claude не трогает.
# Сервер запускается сам, если ещё не запущен: ~/.local/share/llm/start-qwen.sh
set -e
URL=http://127.0.0.1:8080
MODEL=qwen3.8-27b
LLM_DIR="$HOME/.local/share/llm"

if ! curl -sf "$URL/health" >/dev/null; then
    echo "Запускаю Qwen (лог: $LLM_DIR/server.log)..." >&2
    setsid "$LLM_DIR/start-qwen.sh" >"$LLM_DIR/server.log" 2>&1 &
    for _ in $(seq 120); do
        curl -sf "$URL/health" >/dev/null && break
        sleep 1
    done
    curl -sf "$URL/health" >/dev/null || { echo "Сервер не поднялся, смотри $LLM_DIR/server.log" >&2; exit 1; }
fi

export CLAUDE_CONFIG_DIR="$HOME/.claude-local"
export ANTHROPIC_BASE_URL="$URL"
export ANTHROPIC_AUTH_TOKEN=local
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$MODEL"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# Размер контекста сервера (--ctx-size в start-qwen.sh), иначе Claude Code считает 200K и не сжимает чат вовремя
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=32768
exec "$HOME/.local/bin/claude" "$@"
