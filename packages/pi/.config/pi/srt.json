{
  "network": {
    "allowedDomains": [
      "127.0.0.1:8080",
      "mcp.context7.com",
      "mcp.exa.ai"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.gnupg",
      "~/.config/Bitwarden",
      "~/.kaer",
      "~/.claude"
    ],
    "allowRead": [
