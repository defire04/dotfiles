      "~/.local/share/cargo/registry",
      "~/.local/share/cargo/git",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/.m2/repository",
      "~/.m2/wrapper",
      "~/.codegraph",
      "~/.cache",
      "~/.eclipse",
      "~/.pi/agent"
    ],
    "denyWrite": [
      "~/.pi/agent/extensions",
      "~/.pi/agent/npm",
      "~/.pi/agent/git"
    ]
  }
