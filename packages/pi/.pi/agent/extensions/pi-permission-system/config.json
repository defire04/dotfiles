{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "doublePressToConfirm": false,
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "mcp": "allow",
    "skill": "allow",
    "task": "allow",
    "third_party_tool": "ask",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*/.git/*": "deny"
    },
    "external_directory_read": {
      "*": "allow"
    },
    "external_directory_write": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "ls": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "tree *": "allow",
      "tree": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "which *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "date": "allow",
      "date *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "jq *": "allow",
      "cd *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git blame *": "allow",
      "git rev-parse *": "allow",
      "cargo build*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "cargo tree*": "allow",
      "cargo metadata*": "allow",
      "cargo doc*": "allow",
      "mvn *": "allow",
      "./mvnw *": "allow",
      "gradle *": "allow",
      "./gradlew *": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "codegraph *": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "git reset --hard*": "ask",
      "git checkout -- *": "ask",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "sudo *": {
        "action": "deny",
        "reason": "sudo в песочнице не работает, попроси пользователя выполнить сам"
      },
      "find *-exec*": "ask",
      "find *-execdir*": "ask",
      "find *-delete*": "ask",
      "find *-ok *": "ask"
    }
  }
}
